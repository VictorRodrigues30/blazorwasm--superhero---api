@page "/"
@using System.Net.Http.Json
@using BlazorWasmSuperHeroApi.Models
@inject HttpClient Http

<div class="container py-4">

    <div class="row justify-content-center mb-5">
        <div class="col-md-8 text-center">

            <h1 class="display-5 fw-bold text-primary mb-3">
                SuperHero Search
            </h1>

            <p class="text-muted">
                Busque por heróis e vilões usando a API oficial do SuperHero.
            </p>

            <div class="input-group shadow-sm">
                <input type="text"
                       class="form-control form-control-lg"
                       placeholder="Ex: batman, superman, ironman..."
                       @bind="searchTerm"
                       @bind:event="oninput" />

                <button class="btn btn-primary px-4"
                        @onclick="SearchHeroes"
                        disabled="@isLoading">

                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }

                    Pesquisar
                </button>
            </div>

        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger shadow-sm">
            @errorMessage
        </div>
    }

    @if (heroes != null && heroes.Any())
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">

            @foreach (var hero in heroes)
            {
                <div class="col">

                    <div class="card h-100 shadow-sm border-0">
                         
                       <img src="@hero.Image.Url"
                        class="card-img-top object-fit-cover"
                        style="height:300px;"
                        alt="@hero.Name">

                        <div class="card-body">

                            <h5 class="card-title fw-bold">
                                @hero.Name
                                <span class="text-muted fs-6">
                                    (@hero.Biography.FullName)
                                </span>
                            </h5>

                            <p class="card-text text-muted small mb-2">
                                <strong>Editora:</strong>
                                @hero.Biography.Publisher
                            </p>

                            <hr class="text-muted opacity-25" />

                            <h6 class="text-uppercase text-secondary fw-bold">
                                Powerstats
                            </h6>

                            <ul class="list-unstyled small mb-3">
                                <li>
                                    Inteligência:
                                    <strong>@hero.Powerstats.Intelligence</strong>
                                </li>

                                <li>
                                    Força:
                                    <strong>@hero.Powerstats.Strength</strong>
                                </li>

                                <li>
                                    Velocidade:
                                    <strong>@hero.Powerstats.Speed</strong>
                                </li>

                                <li>
                                    Combate:
                                    <strong>@hero.Powerstats.Combat</strong>
                                </li>
                            </ul>

                            <h6 class="text-uppercase text-secondary fw-bold">
                                Aparição
                            </h6>

                            <p class="small text-muted mb-0">
                                @hero.Biography.FirstAppearance
                            </p>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else if (hasSearched && !isLoading)
    {
        <div class="text-center text-muted py-5">
            <p class="fs-5">
                Nenhum personagem encontrado para "@searchTerm".
            </p>
        </div>
    }

</div>

@code {

    private string searchTerm = string.Empty;

    private List<SuperHero>? heroes;

    private bool isLoading = false;

    private bool hasSearched = false;

    private string errorMessage = string.Empty;

    // Coloque aqui o token gerado no site da SuperHero API
    private readonly string accessToken = "5db3268cd250d8fbc3b9c731c2a6ed8b";

    private async Task SearchHeroes()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
            return;

        isLoading = true;
        hasSearched = true;
        errorMessage = string.Empty;
        heroes = null;

        try
        {
            string url =
                $"https://www.superheroapi.com/api.php/{accessToken}/search/{searchTerm.Trim()}";

            var result =
                await Http.GetFromJsonAsync<SuperHeroResponse>(url);

            heroes = result?.Results;
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocorreu um erro ao conectar com a API: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}